system windows
name out/cad.exe
file out/cad.obj
file out/cad_model.obj
file out/cad_create.obj
file out/cad_document.obj
file out/cad_sketch.obj
file out/cad_export.obj
file out/cad_drawing.obj
file out/cad_aircraft.obj
file out/cad_meshview.obj
