#include <windows.h>
#include "cad_ui_ids.h"

IDR_CAD_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N", ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S", ID_FILE_SAVE
        MENUITEM "Save &As...", ID_FILE_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "Export &DXF wireframe...", ID_FILE_DXF
        MENUITEM "Export &OBJ wireframe...", ID_FILE_OBJ
        MENUITEM SEPARATOR
        MENUITEM "E&xit", ID_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y", ID_EDIT_REDO
        MENUITEM "&Delete\tDel", ID_EDIT_DELETE
        MENUITEM "&Properties...\tEnter", ID_EDIT_PROPERTIES
        MENUITEM SEPARATOR
        POPUP "&Constrain"
        BEGIN
            MENUITEM "&Coincident (2 vertices)", ID_CONSTRAIN_COINCIDENT
            MENUITEM "Align &X (2 vertices)", ID_CONSTRAIN_ALIGN_X
            MENUITEM "Align &Y (2 vertices)", ID_CONSTRAIN_ALIGN_Y
            MENUITEM "Align &Z (2 vertices)", ID_CONSTRAIN_ALIGN_Z
            MENUITEM "&Distance... (2 vertices)", ID_CONSTRAIN_DISTANCE
            MENUITEM "&Fix (1 vertex)", ID_CONSTRAIN_FIX
            MENUITEM SEPARATOR
            MENUITEM "D&elete constraint", ID_CONSTRAIN_DELETE
        END
    END
    POPUP "&Create"
    BEGIN
        MENUITEM "&Line...", ID_CREATE_LINE
        MENUITEM "&Rectangle (XY)...", ID_CREATE_RECTANGLE
        MENUITEM "&Box...", ID_CREATE_BOX
        MENUITEM "&Extrude polygon (wireframe)...", ID_CREATE_EXTRUDE
    END
    POPUP "&Part"
    BEGIN
        MENUITEM "Start 2D &Sketch...", ID_FEATURE_SKETCH
        MENUITEM "&Rectangle...", ID_FEATURE_RECT
        MENUITEM "&Circle...", ID_FEATURE_CIRCLE
        MENUITEM "P&olygon...", ID_FEATURE_POLY
        MENUITEM "&Finish Sketch", ID_FEATURE_FINISH
        MENUITEM SEPARATOR
        MENUITEM "&Extrude...", ID_FEATURE_EXTRUDE
        MENUITEM "Re&volve...", ID_FEATURE_REVOLVE
        MENUITEM SEPARATOR
        MENUITEM "Edi&t Feature...", ID_FEATURE_EDIT
        MENUITEM "Re&name Feature...", ID_FEATURE_RENAME
        MENUITEM "Su&ppress / Unsuppress", ID_FEATURE_SUPPRESS
        MENUITEM "Move &Up", ID_FEATURE_UP
        MENUITEM "Move Do&wn", ID_FEATURE_DOWN
        MENUITEM "&Delete Feature", ID_FEATURE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Undo &Last Feature Edit", ID_FEATURE_UNDO
    END
    POPUP "&Insert"
    BEGIN
        MENUITEM "Place &Component...", ID_INSERT_PLACE
        MENUITEM "&Move Component...", ID_INSERT_MOVE
        MENUITEM "&Ground/Unground", ID_INSERT_GROUND
        MENUITEM "&Remove Component", ID_INSERT_REMOVE
        MENUITEM SEPARATOR
        MENUITEM "Re&load Components", ID_INSERT_RELOAD
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Orbit (left/right-drag)", ID_VIEW_ORBIT
        MENUITEM "&Front", ID_VIEW_FRONT
        MENUITEM "&Top", ID_VIEW_TOP
        MENUITEM "&Side", ID_VIEW_SIDE
        MENUITEM "&Isometric", ID_VIEW_ISO
        MENUITEM "&Drawing sheet", ID_VIEW_DRAWING
        MENUITEM "&Grid", ID_VIEW_GRID
        MENUITEM "&Zoom all (fit)", ID_VIEW_FIT
        MENUITEM "Hom&e view", ID_VIEW_HOME
        MENUITEM "&Pan (left-drag)", ID_VIEW_PAN
        MENUITEM "Zoo&m (left-drag)", ID_VIEW_ZOOM
        POPUP "&Ribbon tab"
        BEGIN
            MENUITEM "&1 3D Model", ID_RIBBON_TAB0
            MENUITEM "&2 Sketch", 321
            MENUITEM "&3 Assemble", 322
            MENUITEM "&4 Constrain", 323
            MENUITEM "&5 Manage", 324
            MENUITEM "&6 View", ID_RIBBON_TAB5
        END
        MENUITEM SEPARATOR
        MENUITEM "&Wireframe", ID_VIEW_WIREFRAME
        MENUITEM "S&haded", ID_VIEW_SHADED
    END
    POPUP "&Tools"
    BEGIN
        POPUP "&Units (no rescaling)"
        BEGIN
            MENUITEM "&Unspecified", ID_TOOLS_UNSPECIFIED
            MENUITEM "&Millimetres", ID_TOOLS_MM
        END
        MENUITEM "&Parameters (fx)...", ID_TOOLS_PARAMETERS
        MENUITEM "Run &Macro...", ID_TOOLS_RUN_MACRO
        MENUITEM SEPARATOR
        MENUITEM "&Snap to 10\tF9", ID_TOOLS_SNAP
        MENUITEM "&Debug test status", ID_TOOLS_TEST_STATUS
    END
    POPUP "&Demos"
    BEGIN
        MENUITEM "&House (replace document)...", ID_DEMO_HOUSE
        MENUITEM "&Boeing 747-400 (replace document)...", ID_DEMO_747
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About / controls...", ID_HELP_ABOUT
    END
END

IDR_CAD_KEYS ACCELERATORS
BEGIN
    "N", ID_FILE_NEW, VIRTKEY, CONTROL
    "O", ID_FILE_OPEN, VIRTKEY, CONTROL
    "S", ID_FILE_SAVE, VIRTKEY, CONTROL
    "Z", ID_EDIT_UNDO, VIRTKEY, CONTROL
    "Y", ID_EDIT_REDO, VIRTKEY, CONTROL
    VK_DELETE, ID_EDIT_DELETE, VIRTKEY
    VK_RETURN, ID_EDIT_PROPERTIES, VIRTKEY
    VK_F9, ID_TOOLS_SNAP, VIRTKEY
END

IDD_COORDINATES DIALOG 0, 0, 222, 160
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Coordinates"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "Integers or parameter expressions (-400..400); sizes positive.", -1, 8, 7, 206, 18
    LTEXT "X", IDC_LABEL1, 8, 30, 90, 10
    EDITTEXT IDC_VALUE1, 108, 28, 100, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Y", IDC_LABEL2, 8, 47, 90, 10
    EDITTEXT IDC_VALUE2, 108, 45, 100, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Z", IDC_LABEL3, 8, 64, 90, 10
    EDITTEXT IDC_VALUE3, 108, 62, 100, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Width", IDC_LABEL4, 8, 81, 90, 10
    EDITTEXT IDC_VALUE4, 108, 79, 100, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Height", IDC_LABEL5, 8, 98, 90, 10
    EDITTEXT IDC_VALUE5, 108, 96, 100, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Depth", IDC_LABEL6, 8, 115, 90, 10
    EDITTEXT IDC_VALUE6, 108, 113, 100, 12, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 106, 139, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 162, 139, 50, 14
END

IDD_EXTRUSION DIALOG 0, 0, 272, 132
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Extrude polygon sketch"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "XY polygon: 3..12 points, x,y;x,y;... (-400..400).", -1, 8, 8, 256, 12
    LTEXT "Closing edge is implicit. No repeated first point or crossings.", -1, 8, 22, 256, 12
    LTEXT "&Profile", -1, 8, 40, 48, 10
    EDITTEXT IDC_PROFILE, 8, 54, 256, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Height (+Z, 1..400, fx)", -1, 8, 78, 110, 12
    EDITTEXT IDC_HEIGHT, 126, 76, 62, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 156, 108, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 214, 108, 50, 14
END

IDD_PARAMETERS DIALOG 0, 0, 280, 184
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Parameters (fx)"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "&Name", -1, 8, 8, 40, 10
    EDITTEXT IDC_PARAM_NAME, 52, 6, 100, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Expression", -1, 8, 25, 40, 10
    EDITTEXT IDC_PARAM_EXPR, 52, 23, 220, 12, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "&Add", IDC_PARAM_ADD, 52, 40, 50, 14
    PUSHBUTTON "&Modify", IDC_PARAM_MODIFY, 108, 40, 50, 14
    PUSHBUTTON "&Delete", IDC_PARAM_DELETE, 164, 40, 50, 14
    LISTBOX IDC_PARAM_LIST, 8, 60, 264, 92, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "", IDC_PARAM_UNITS, 8, 160, 200, 18
    PUSHBUTTON "Close", IDCANCEL, 222, 162, 50, 14
END

IDD_DISTANCE DIALOG 0, 0, 200, 92
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Distance constraint"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "Second minus first vertex along:", IDC_DIST_LABEL, 8, 8, 184, 10
    CONTROL "&X", IDC_AXIS_X, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 8, 22, 30, 12
    CONTROL "&Y", IDC_AXIS_Y, "BUTTON", BS_AUTORADIOBUTTON, 44, 22, 30, 12
    CONTROL "&Z", IDC_AXIS_Z, "BUTTON", BS_AUTORADIOBUTTON, 80, 22, 30, 12
    LTEXT "&Value (expression)", -1, 8, 42, 70, 10
    EDITTEXT IDC_DIST_VALUE, 82, 40, 110, 12, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    DEFPUSHBUTTON "OK", IDOK, 86, 70, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 142, 70, 50, 14
END

IDD_PLACEMENT DIALOG 0, 0, 230, 136
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Place component"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "", IDC_PLACE_PATH, 8, 6, 214, 10
    LTEXT "Offsets: integers -2000..2000 or fx expressions (-400..400).", -1, 8, 18, 214, 10
    LTEXT "&X offset", IDC_LABEL1, 8, 36, 96, 10
    EDITTEXT IDC_VALUE1, 112, 34, 104, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Y offset", IDC_LABEL2, 8, 53, 96, 10
    EDITTEXT IDC_VALUE2, 112, 51, 104, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Z offset", IDC_LABEL3, 8, 70, 96, 10
    EDITTEXT IDC_VALUE3, 112, 68, 104, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Yaw about +Y (0, 45 ... 315 deg)", IDC_LABEL4, 8, 87, 102, 10
    EDITTEXT IDC_VALUE4, 112, 85, 104, 12, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 112, 114, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 168, 114, 50, 14
END

IDD_FEAT_SKETCH DIALOG 0, 0, 204, 96
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Start 2D Sketch"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "Sketch plane (the view turns to face it):", -1, 8, 8, 188, 10
    CONTROL "&XY (front)", IDC_FEAT_OPT1, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 8, 22, 58, 12
    CONTROL "X&Z (top)", IDC_FEAT_OPT2, "BUTTON", BS_AUTORADIOBUTTON, 70, 22, 58, 12
    CONTROL "&YZ (side)", IDC_FEAT_OPT3, "BUTTON", BS_AUTORADIOBUTTON, 132, 22, 64, 12
    LTEXT "&Offset (expression)", -1, 8, 44, 76, 10
    EDITTEXT IDC_VALUE1, 88, 42, 108, 12, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    DEFPUSHBUTTON "OK", IDOK, 90, 74, 50, 14, WS_GROUP
    PUSHBUTTON "Cancel", IDCANCEL, 146, 74, 50, 14
END

IDD_FEAT_PROFILE DIALOG 0, 0, 240, 128
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sketch profile"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "Sketch coordinates u,v; every value is an expression such as W/2.", IDC_FEAT_HINT, 8, 6, 224, 18
    LTEXT "Center u", IDC_LABEL1, 8, 30, 96, 10
    EDITTEXT IDC_VALUE1, 110, 28, 122, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Center v", IDC_LABEL2, 8, 47, 96, 10
    EDITTEXT IDC_VALUE2, 110, 45, 122, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Width", IDC_LABEL3, 8, 64, 96, 10
    EDITTEXT IDC_VALUE3, 110, 62, 122, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Height", IDC_LABEL4, 8, 81, 96, 10
    EDITTEXT IDC_VALUE4, 110, 79, 122, 12, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_FEAT_POINTS, 8, 30, 224, 12, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 126, 106, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 182, 106, 50, 14
END

IDD_FEAT_SOLID DIALOG 0, 0, 240, 126
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Extrude"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "&Sketch", -1, 8, 8, 70, 10
    COMBOBOX IDC_FEAT_SKETCH, 82, 6, 150, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Profile (ALL or 1..n)", IDC_LABEL1, 8, 26, 72, 10
    EDITTEXT IDC_VALUE1, 82, 24, 150, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Distance (expression)", IDC_LABEL2, 8, 43, 72, 10
    EDITTEXT IDC_VALUE2, 82, 41, 150, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Direction:", IDC_FEAT_GROUP, 8, 60, 120, 10
    CONTROL "&Normal", IDC_FEAT_OPT1, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 8, 72, 60, 12
    CONTROL "&Reverse", IDC_FEAT_OPT2, "BUTTON", BS_AUTORADIOBUTTON, 72, 72, 60, 12
    CONTROL "S&ymmetric", IDC_FEAT_OPT3, "BUTTON", BS_AUTORADIOBUTTON, 136, 72, 70, 12
    DEFPUSHBUTTON "OK", IDOK, 126, 104, 50, 14, WS_GROUP
    PUSHBUTTON "Cancel", IDCANCEL, 182, 104, 50, 14
END

IDD_FEAT_RENAME DIALOG 0, 0, 200, 62
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename feature"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "&Name (1..31 characters, unique)", -1, 8, 8, 184, 10
    EDITTEXT IDC_VALUE1, 8, 20, 184, 12, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 86, 40, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 142, 40, 50, 14
END

/* Ribbon, navigation bar and browser icons (IDB_* from res/icon_ids.h). */
